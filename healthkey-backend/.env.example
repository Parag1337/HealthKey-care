# Server
PORT=5000

# MongoDB connection string (127.0.0.1 avoids IPv6 localhost resolution failures).
# The hk-mongo podman container requires the root credentials defined in
# ~/.config/healthkey/mongo.env and the authSource=admin parameter.
MONGO_URI=mongodb://healthkey_admin:CHANGE_THIS_TO_A_STRONG_PASSWORD@127.0.0.1:27017/healthkey?authSource=admin

# REQUIRED — JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT lifetime (default 30d)
JWT_EXPIRES_IN=30d

# Frontend origin (used for CORS and QR deep links)
FRONTEND_URL=http://localhost:3000

# Doctor QR token lifetime in hours (default 168 = 7 days)
QR_TOKEN_TTL_HOURS=168

# Maximum upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Cloudinary — medical document storage (see CLOUDINARY_SETUP.md).
# The API secret must NEVER be added to frontend code or committed to git.
# Leave CLOUDINARY_CLOUD_NAME empty to run the local simulation backend,
# or set CLOUDINARY_SIMULATION=true to force simulation explicitly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=